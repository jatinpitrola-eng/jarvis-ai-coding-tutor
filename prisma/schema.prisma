// Jarvis Prisma schema
// A coding-tutor PWA: chat history + structured learning tracks + playground progress.
// No auth — we identify learners by a deviceId generated in localStorage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A learner's device (identified by localStorage-generated id)
model Learner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  ChatSession[]
  progress  LessonProgress[]
  exercises PlaygroundAttempt[]
}

// A chat conversation (text or voice)
model ChatSession {
  id        String   @id @default(cuid())
  learnerId String
  title     String   @default("New chat")
  mode      String   @default("text") // "text" | "voice"
  language  String?  // focused language e.g. "python"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learner  Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([learnerId])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// A learning track (e.g. "Python Basics"). Tracks are seeded/created on demand.
model LearningTrack {
  id          String  @id @default(cuid())
  slug        String  @unique // e.g. "python-basics"
  title       String
  language    String  // "python", "javascript", ...
  description String
  icon        String  @default("terminal")
  difficulty  String  @default("beginner") // beginner | intermediate | advanced
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  lessons Lesson[]
}

// A lesson inside a track. Content is markdown generated by the AI tutor.
model Lesson {
  id        String   @id @default(cuid())
  trackId   String
  order     Int
  title     String
  summary   String
  content   String // markdown body
  createdAt DateTime @default(now())

  track    LearningTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  exercises PlaygroundExercise[]

  @@index([trackId])
}

// Per-learner progress on a lesson
model LessonProgress {
  id        String   @id @default(cuid())
  learnerId String
  lessonId  String
  status    String   @default("not_started") // not_started | in_progress | completed
  updatedAt DateTime @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
  @@index([learnerId])
}

// A coding exercise generated by the tutor (for the Playground)
model PlaygroundExercise {
  id         String   @id @default(cuid())
  lessonId   String?
  language   String
  prompt     String   // the challenge description (markdown)
  starter    String?  // starter code
  solution   String?  // reference solution (not shown to learner)
  hints      String?  // JSON array of hints
  difficulty String   @default("easy")
  createdAt  DateTime @default(now())

  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts   PlaygroundAttempt[]

  @@index([lessonId])
}

// A learner's attempt at an exercise, with AI feedback
model PlaygroundAttempt {
  id         String   @id @default(cuid())
  learnerId  String
  exerciseId String
  code       String
  feedback   String?  // AI review (markdown)
  score      Int?     // 0..100
  passed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  learner  Learner            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  exercise PlaygroundExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([exerciseId])
}
